<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ArtGallery"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digital Exhibition"
        android:textSize="18sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Exhibition Theme"
        android:textSize="16sp"
        android:textStyle="italic"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnPaintings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Paintings"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSculptures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sculptures"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnPhotography"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Photography"
        android:layout_marginBottom="24dp" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
